#!/bin/sh
# Starts DHCP on a wired port that appears after the boot: a USB Ethernet
# chip (the Ethernet of a Raspberry Pi is one) or a USB adapter can come
# up after S40neptron-network ran. mdev runs this script for each network
# port it sees (the rule is in /etc/mdev.conf), with ACTION and MDEV in the
# environment.
#
# Before S40neptron-network has run (its pid folder is missing), the
# script does nothing: S40neptron-network starts every port itself, after
# the state and share partitions. S40neptron-network start skips a port
# whose client runs and returns at once, so the script never blocks mdev
# for long.

# The first argument puts every path below another folder, for a test.
# mdev runs the script with no argument. It is no environment variable:
# init passes unknown kernel parameters into the environment of mdev.
root=${1:-}

[ "${ACTION:-}" = add ] || exit 0
case ${MDEV:-} in
eth* | en*) ;;
*) exit 0 ;;
esac
[ -d "$root/run/neptron/dhcp" ] || exit 0
exec "$root/etc/init.d/S40neptron-network" start
