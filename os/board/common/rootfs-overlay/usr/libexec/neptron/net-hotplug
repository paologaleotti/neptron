#!/bin/sh
# Starts DHCP on a wired port that appears after the boot, and stops the
# client of a port that goes: a USB Ethernet chip (the Ethernet of a
# Raspberry Pi is one) or a USB adapter can come up after
# S40neptron-network ran, and can be unplugged and plugged in again. mdev
# runs this script for each network port it adds or removes (the rule is
# in /etc/mdev.conf), with ACTION and MDEV in the environment.
#
# Before S40neptron-network has run (its pid folder is missing), the
# script does nothing: S40neptron-network starts every port itself, after
# the state and share partitions. S40neptron-network returns at once, so
# the script never blocks mdev for long. Its lines go to syslog, because
# mdev gives the script no console.

# mdev sets umask 0; S40neptron-network sets its own too.
umask 022

# The first argument puts every path below another folder, for a test.
# mdev runs the script with no argument. It is no environment variable:
# init passes unknown kernel parameters into the environment of mdev.
root=${1:-}

case ${MDEV:-} in
eth* | en*) ;;
*) exit 0 ;;
esac
case ${ACTION:-} in
add) set -- start ;;
remove) set -- port-gone "$MDEV" ;;
*) exit 0 ;;
esac
[ -d "$root/run/neptron/dhcp" ] || exit 0
"$root/etc/init.d/S40neptron-network" "$@" 2>&1 | logger -t neptron-network
