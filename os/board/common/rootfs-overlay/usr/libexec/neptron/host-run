#!/bin/sh
# Runs a script that `cargo xtask` passes through the QEMU firmware config,
# prints its exit code between markers, and stops the guest. The argument
# names the entry:
#
#   run     the command of `cargo xtask qemu`. S99neptron-run starts it at
#           the end of the boot scripts, before the launcher.
#   check   the boot check of `cargo xtask os boot-check`. Init starts it
#           with the launcher, so the image boots as it does on a PC.
#
# On a PC there is no firmware config, and the script exits at once.
#
# The markers carry the nonce of the run, so output of the script cannot end
# the run. The guest enforces the deadline itself, so it stops in time even
# when the host process is gone.

entry=$1
fw=/sys/firmware/qemu_fw_cfg/by_name/opt/neptron
[ -r "$fw/$entry/raw" ] || exit 0

script=/tmp/neptron-$entry.sh
cp "$fw/$entry/raw" "$script"
nonce=$(cat "$fw/nonce/raw")
deadline=$(cat "$fw/timeout/raw")
read -r uptime _ < /proc/uptime
echo "NEPTRON-BEGIN $nonce $uptime"
(cd / && timeout -s KILL "$deadline" sh "$script") < /dev/null 2>&1
code=$?
[ "$code" -eq 137 ] && echo "neptron-run: exit code 137: the deadline of $deadline s, or another SIGKILL"
echo "NEPTRON-END $nonce $code"
reboot -f
