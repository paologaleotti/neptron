#!/bin/sh
# Mounts the state partition (ext4) at /state and the share partition
# (exFAT) at /share. They are partitions 3 and 4 of the disk that holds the
# root filesystem, so another disk with the same layout is never used. When
# the boot disk has no such partition (a QEMU run that boots the root
# filesystem alone), a RAM folder takes its place and nothing is kept.
#
# The image has no share partition. On the first boot it is made from the
# free space after the state partition and formatted exFAT, as the
# definition asks; the rules are below.
#
# The frontend cannot see a RAM folder, so the script writes what it
# mounted, and why, to /run/neptron/storage.toml (a RAM file system: the
# file is new at each boot). The frontend shows a notice for each RAM
# folder, with the reason. Every line of the script also goes to syslog
# with the tag neptron-storage, because the console of a PC is not kept,
# and, when /state is mounted, to /state/log/storage.log, because /var/log
# is a RAM folder.
#
# A second argument puts every path of the script below that folder, for a
# test. Init never gives one; a variable would not do, because init passes
# the kernel command line to its children as variables.

[ "$1" = start ] || exit 0

R=${2:-}
STATE=$R/state
SHARE=$R/share
DEV=$R/dev
STATUS_DIR=$R/run/neptron
STATUS=$STATUS_DIR/storage.toml
SYSTEMS=$R/usr/share/neptron/systems

# The read-only root of the PC image has the mount points already.
mkdir -p "$STATE" "$SHARE" 2>/dev/null

# The network share (S45neptron-share) maps every client to the user nobody,
# so nobody owns /share and can write it. exFAT stores no owner: every file
# shows as nobody, and root (the frontend) reads and writes all of it.
# Nothing on the share runs as a program.
SHARE_OWNER=65534
SHARE_MOUNT_OPTIONS="noatime,iocharset=utf8,uid=$SHARE_OWNER,gid=$SHARE_OWNER,dmask=0022,fmask=0133,nosuid,nodev,noexec"
SHARE_RAM_OPTIONS="mode=0755,uid=$SHARE_OWNER,gid=$SHARE_OWNER,nosuid,nodev,noexec"

# Every flag that the script reads is set here first: a variable of init
# with the same name must not change a decision.
state_writable=no
state_kind=partition
share_kind=partition
state=
share=
last=
entry=
boot_lines=

# Logs one line to the console and to syslog, and keeps it for the storage
# log. syslogd starts before this script (S01syslogd); without it, the line
# is on the console and in the storage log only.
log() {
	echo "neptron-storage: $1"
	logger -t neptron-storage "$1" 2>/dev/null
	boot_lines="$boot_lines$1
"
}

# Logs one line and keeps it as the reason of the next RAM folder.
say() {
	log "$1"
	last=$1
}

# Mounts a RAM folder for $1 (state or share) and notes it, with the last
# line as the reason.
ram_folder() {
	options=mode=0755
	[ "$1" = share ] && options=$SHARE_RAM_OPTIONS
	mount -t tmpfs -o "$options" "$1" "$R/$1" || log "the RAM folder of /$1 does not mount"
	reason=$(printf '%s' "${last:-the storage script gave no reason}" | tr -d '"\\')
	case $1 in
	state) state_kind=ram state_reason=$reason ;;
	share) share_kind=ram share_reason=$reason ;;
	esac
}
# The device of partition $2 of the disk at sysfs path $1, as the kernel
# sees it.
partition() {
	for file in "$1"/*/partition; do
		[ -r "$file" ] || continue
		if [ "$(cat "$file")" = "$2" ]; then
			dir=${file%/partition}
			echo "$DEV/${dir##*/}"
			return 0
		fi
	done
	return 1
}

root=$(mountpoint -d /)
root_dir=$(readlink -f "$R/sys/dev/block/$root")
disk=
if [ -r "$root_dir/partition" ]; then
	disk=${root_dir%/*}
	disk_dev=$DEV/${disk##*/}
	state=$(partition "$disk" 3)
fi

# e2fsck -p exits with 0 (clean), 1 or 2 (errors corrected); 4 and above
# leave errors, and then the state partition is not mounted for writing.
if [ -z "$disk" ]; then
	say "the root filesystem is not on a partition of a disk, so there is no state partition; /state is a RAM folder"
	ram_folder state
elif [ -z "$state" ]; then
	say "the boot disk has no partition 3, so there is no state partition; /state is a RAM folder"
	ram_folder state
else
	e2fsck -p "$state"
	code=$?
	if [ "$code" -ge 4 ]; then
		say "e2fsck $state left errors (exit $code); /state is a RAM folder"
		ram_folder state
	elif ! mount -t ext4 -o noatime "$state" "$STATE"; then
		say "$state does not mount; /state is a RAM folder"
		ram_folder state
	else
		state_writable=yes
		log "$state mounted at /state (e2fsck exit $code)"
	fi
fi

# The share partition (partition 4) is made and formatted by this script
# only. It formats a partition 4 only when all of these hold, so the games
# of the user are never formatted away:
#
# - The marker /state/share-pending is there: this script wrote it, with a
#   sync, before it made the partition, and removes it after the first
#   mount. A partition 4 with no marker is never formatted, whatever is on
#   it. A stick written again with dd has a new state partition with no
#   marker; the script makes partition 4 again with a new marker, but only
#   when the free space holds no old share at another start (the scan
#   below). An old share at the planned start becomes partition 4 again,
#   and it holds a filesystem, so it is mounted as it is.
# - Its type is 0x07 and it starts at the first 1 MiB boundary after the
#   state partition.
# - Its first 16 MiB read with no error, and blkid exits with 2 (nothing
#   found) and prints nothing: a read error is never taken for an empty
#   partition.
# - It holds no exFAT backup boot sector (sector 12 of the exFAT sector
#   size, which is 512 to 4096 bytes): a damaged main boot sector with a
#   good backup is the user's share, not an empty partition.
#
# When a check fails, nothing is formatted or mounted, /share is a RAM
# folder, and one line says why.

# The smallest free space that becomes a share partition, in 512-byte
# sectors (64 MiB).
SHARE_MIN_SECTORS=131072
# sfdisk starts a new partition on the next 1 MiB boundary, in sectors.
ALIGN_SECTORS=2048
# The start of the partition that must read cleanly before a format, in
# MiB.
READ_CHECK_MIB=16
# The exFAT backup boot sector is sector 12 of the exFAT sector size: at
# these 512-byte sectors for exFAT sectors of 512, 1024, 2048 and 4096
# bytes.
EXFAT_BACKUP_SECTORS="12 24 48 96"
# How far into the free space the script looks for an old share before it
# makes partition 4, in sectors (4 GiB): layouts of other image versions
# place the share start within this distance.
OLD_SHARE_SCAN_SECTORS=8388608
# addpart gives partition 4 to the kernel at most this many times, with
# this pause between two tries, in microseconds: a slow stick can still be
# busy with the write of the table.
ADD_TRIES=5
ADD_RETRY_US=500000
# sfdisk --dump reads the table at most this many times, with this pause
# between two tries, in microseconds.
TABLE_READ_TRIES=5
TABLE_READ_RETRY_US=500000
# The storage log on the state partition keeps this many lines: the last
# boots.
STORAGE_LOG_LINES=300
# The device node of a new partition must appear within this many pauses
# of this length, in microseconds (5 s in all).
NODE_WAIT_STEPS=50
NODE_WAIT_STEP_US=100000
MARKER=$STATE/share-pending

sectors() {
	cat "$R/sys/class/block/${1##*/}/$2"
}

state_end() {
	echo $(($(sectors "$state" start) + $(sectors "$state" size)))
}

# The sector where this script places partition 4.
planned_start() {
	end=$(state_end)
	echo $(((end + ALIGN_SECTORS - 1) / ALIGN_SECTORS * ALIGN_SECTORS))
}

# The 8 bytes of the file system name of the boot sector at sector $2 of
# device $1 (offset 3 of the sector).
boot_name() {
	dd if="$1" bs=512 skip="$2" count=1 2>/dev/null | dd bs=1 skip=3 count=8 2>/dev/null
}

# 0 when blkid finds a filesystem or a partition table on $1, 1 when it
# finds nothing, 2 when the probe is not clean. blkid also reports the
# partition entry itself (PART_ENTRY_*), so only TYPE and PTTYPE count.
signature() {
	errors=$(blkid -p -o export "$1" 2>&1 >/dev/null)
	found=$(blkid -p -o export "$1" 2>/dev/null)
	code=$?
	if [ "$code" -eq 0 ] && echo "$found" | grep -q -e '^TYPE=' -e '^PTTYPE='; then
		return 0
	fi
	if { [ "$code" -eq 2 ] || [ "$code" -eq 0 ]; } && [ -z "$errors" ]; then
		return 1
	fi
	return 2
}

# Reads the partition table on the disk, not as the kernel sees it, into
# table. Fails when sfdisk cannot read it after the tries.
read_table() {
	tries=0
	while [ "$tries" -lt "$TABLE_READ_TRIES" ]; do
		tries=$((tries + 1))
		if table=$(sfdisk --dump "$disk_dev" 2>&1); then
			return 0
		fi
		log "sfdisk --dump try $tries of $TABLE_READ_TRIES failed: $(printf '%s' "$table" | tr '\n' ' ')"
		[ "$tries" -lt "$TABLE_READ_TRIES" ] && usleep "$TABLE_READ_RETRY_US"
	done
	return 1
}

# Partition 4 of the table that read_table read, as "start size type", or
# nothing. sfdisk names it sda4, nvme0n1p4 or mmcblk0p4.
entry_of_table() {
	printf '%s\n' "$table" |
		sed -n 's/^[^ ]*[^0-9]4 : start= *\([0-9]*\), size= *\([0-9]*\), type=\([0-9a-fA-F]*\).*/\1 \2 \3/p'
}

# Why partition 4 of the table (start $1, size $2, type $3) is not the one
# this script plans, or nothing.
plan_mismatch() {
	planned=$(planned_start)
	disk_sectors=$(cat "$disk/size")
	if [ "$3" != 7 ] || [ "$1" != "$planned" ] || [ "$2" -lt "$SHARE_MIN_SECTORS" ] ||
		[ $(($1 + $2)) -gt "$disk_sectors" ]; then
		echo "the table holds partition 4 at sector $1 with $2 sectors and type $3, not type 7 at sector $planned within the $disk_sectors sectors of the disk"
	fi
}

# Why partition 4 ($1) may not be formatted, as the end of a sentence that
# starts with its name, or nothing.
format_refusal() {
	if [ ! -e "$MARKER" ]; then
		echo "is empty and has no /state/share-pending, so it is left untouched"
		return
	fi
	start=$(sectors "$1" start)
	end=$(state_end)
	# sfdisk prints the MBR type with a leading space (" 7").
	if [ "$(sfdisk --part-type "$disk_dev" 4 2>/dev/null | tr -d ' ')" != 7 ] ||
		[ "$start" -lt "$end" ] || [ "$start" -ge $((end + ALIGN_SECTORS)) ]; then
		echo "was left untouched: its type or its start is not those of the share partition of this image"
		return
	fi
	if ! dd if="$1" of=/dev/null bs=1M count="$READ_CHECK_MIB" 2>/dev/null; then
		echo "was left untouched: its first $READ_CHECK_MIB MiB do not read cleanly"
		return
	fi
	for backup in $EXFAT_BACKUP_SECTORS; do
		if [ "$(boot_name "$1" "$backup")" = "EXFAT   " ]; then
			echo "was left untouched: it holds an exFAT backup boot sector (sector $backup), so it is a damaged share"
			return
		fi
	done
}

# The first sector of the free space after the state partition that holds
# an exFAT boot sector, at a 1 MiB boundary, or nothing.
old_share() {
	disk_sectors=$(cat "$disk/size")
	sector=$(planned_start)
	scan_end=$((sector + OLD_SHARE_SCAN_SECTORS))
	[ "$scan_end" -gt "$disk_sectors" ] && scan_end=$disk_sectors
	while [ "$sector" -lt "$scan_end" ]; do
		if [ "$(boot_name "$disk_dev" "$sector")" = "EXFAT   " ]; then
			echo "$sector"
			return
		fi
		sector=$((sector + ALIGN_SECTORS))
	done
}

# Writes partition 4 to the table on the disk.
make_partition() {
	if [ "$state_writable" != yes ]; then
		say "the state partition is not mounted, so no share partition is made"
		return 1
	fi
	free=$(($(cat "$disk/size") - $(state_end)))
	if [ "$free" -lt "$SHARE_MIN_SECTORS" ]; then
		say "$free free sectors after the state partition, less than $SHARE_MIN_SECTORS, so the disk has no room for a share partition"
		return 1
	fi
	old=$(old_share)
	planned=$(planned_start)
	if [ -n "$old" ] && [ "$old" != "$planned" ]; then
		say "an old exFAT share starts at sector $old, not at $planned; no share partition made, the disk is left untouched"
		return 1
	fi
	if [ -n "$old" ]; then
		log "an old exFAT share starts at sector $planned; partition 4 is made around it and keeps its files"
	fi
	log "making partition 4 at sector $planned from $free free sectors"
	if ! { echo "partition 4 made at $(date)" > "$MARKER" && sync; }; then
		say "$MARKER cannot be written, so no share partition is made"
		return 1
	fi
	# The root and state partitions of this disk are mounted, so sfdisk
	# refuses the disk unless forced, and the kernel cannot read the whole
	# table again: addpart gives it partition 4 alone (kernel_add). The
	# space can hold the share of an older image, so no signature is wiped.
	# A lock that another program holds fails at once and never stops the
	# boot. The start is given: a start that sfdisk chooses follows the
	# optimal I/O size of the device, which can be larger than 1 MiB.
	output=$(printf '%s,,7\n' "$planned" | sfdisk --quiet --force --no-reread --no-tell-kernel \
		--wipe never --wipe-partitions never --lock=nonblock --append "$disk_dev" 2>&1)
	code=$?
	[ -n "$output" ] && log "sfdisk exit $code: $(printf '%s' "$output" | tr '\n' ' ')"
	# The exit status of sfdisk proves nothing in either direction: it can
	# fail after the table is written (a failed fsync). The table read back
	# decides. BLKFLSBUF on the whole disk writes its dirty pages and drops
	# its clean ones; the mounted partitions have caches of their own, which
	# it does not touch. The read back then comes from the device, not from
	# the cache that sfdisk wrote.
	flushed=$(blockdev --flushbufs "$disk_dev" 2>&1)
	flush_code=$?
	if [ "$flush_code" -eq 0 ]; then
		log "blockdev --flushbufs exit 0: the table is read back from the device"
	else
		log "blockdev --flushbufs exit $flush_code: the table is read back from the cache, not from the device${flushed:+: $(printf '%s' "$flushed" | tr '\n' ' ')}"
	fi
	if ! read_table; then
		say "the partition table cannot be read back after sfdisk (exit $code); the marker stays and the next boot uses partition 4"
		return 1
	fi
	entry=$(entry_of_table)
	if [ -z "$entry" ]; then
		rm -f "$MARKER"
		sync
		say "sfdisk exit $code, and the partition table has no partition 4, so no share partition is made"
		return 1
	fi
	# shellcheck disable=SC2086 # the three numbers of the entry
	mismatch=$(plan_mismatch $entry)
	if [ -n "$mismatch" ]; then
		rm -f "$MARKER"
		sync
		say "sfdisk exit $code, and $mismatch; the share partition is left untouched"
		return 1
	fi
	log "the partition table holds partition 4 as planned ($entry), sfdisk exit $code"
}

# Gives the kernel partition 4 with start $1 and size $2, in sectors, and
# sets share to its device. The kernel reads the table only at boot, and
# the mounted partitions stop a full read again. addpart (BLKPG) takes the
# numbers of the table read back and reads no table itself. Its exit status
# proves nothing: the kernel's list decides.
kernel_add() {
	tries=0
	while [ "$tries" -lt "$ADD_TRIES" ]; do
		tries=$((tries + 1))
		output=$(addpart "$disk_dev" 4 "$1" "$2" 2>&1)
		code=$?
		share=$(partition "$disk" 4) && return 0
		log "addpart try $tries of $ADD_TRIES, exit $code: the kernel does not see partition 4${output:+: $(printf '%s' "$output" | tr '\n' ' ')}"
		[ "$tries" -lt "$ADD_TRIES" ] && usleep "$ADD_RETRY_US"
	done
	say "partition 4 is in the partition table, but the kernel does not see it after $ADD_TRIES tries of addpart (last exit $code); restart to use it"
	return 1
}

# Waits until the device node $1 exists.
wait_node() {
	steps=0
	while [ ! -e "$1" ]; do
		if [ "$steps" -ge "$NODE_WAIT_STEPS" ]; then
			say "the kernel sees partition 4, but its device node $1 does not appear within $((NODE_WAIT_STEPS * NODE_WAIT_STEP_US / 1000)) ms"
			return 1
		fi
		usleep "$NODE_WAIT_STEP_US"
		steps=$((steps + 1))
	done
}

# Prepares partition 4 for the mount: a partition with a filesystem stays
# as it is; an empty one is formatted only by the rules above.
prepare_share() {
	signature "$share"
	case $? in
	0)
		# A partition with a filesystem never needs the permission to
		# format again, also when its mount fails.
		if [ -e "$MARKER" ]; then
			rm -f "$MARKER"
			sync
			log "partition 4 holds a filesystem, so /state/share-pending is removed"
		fi
		return 0
		;;
	2)
		say "the share partition $share was left untouched: blkid could not probe it cleanly"
		return 1
		;;
	esac
	reason=$(format_refusal "$share")
	if [ -n "$reason" ]; then
		say "the share partition $share $reason"
		return 1
	fi
	log "$share holds no filesystem; formatting it exFAT"
	mkfs.exfat -L NEPTRON "$share" || {
		say "mkfs.exfat failed on $share"
		return 1
	}
}

# Each way that ends with no share device names its reason with say.
last=
share=
if [ -z "$disk" ]; then
	say "the root filesystem is not on a partition of a disk, so there is no share partition"
elif share=$(partition "$disk" 4); then
	:
elif ! read_table; then
	say "the partition table of $disk_dev cannot be read, so no share partition is made"
elif entry=$(entry_of_table) && [ -n "$entry" ]; then
	log "partition 4 is in the partition table ($entry), but the kernel does not see it"
	# shellcheck disable=SC2086 # the three numbers of the entry
	kernel_add $entry || share=
elif [ -z "$state" ]; then
	say "the boot disk has no partition 3, so no share partition is made"
elif make_partition; then
	# shellcheck disable=SC2086 # the three numbers of the entry
	kernel_add $entry || share=
else
	share=
fi
mounted=no
if [ -n "$share" ] && wait_node "$share" && prepare_share; then
	if mount -t exfat -o "$SHARE_MOUNT_OPTIONS" "$share" "$SHARE"; then
		mounted=yes
	else
		say "$share does not mount"
	fi
fi
if [ "$mounted" = yes ]; then
	log "$share mounted at /share"
	if [ -e "$MARKER" ]; then
		rm -f "$MARKER"
		sync
	fi
else
	log "/share is a RAM folder: $last"
	ram_folder share
fi

status() {
	echo "state = \"$state_kind\""
	if [ "$state_kind" = ram ]; then
		echo "state_reason = \"$state_reason\""
	fi
	echo "share = \"$share_kind\""
	if [ "$share_kind" = ram ]; then
		echo "share_reason = \"$share_reason\""
	fi
}
if ! { mkdir -p "$STATUS_DIR" && status > "$STATUS"; }; then
	log "$STATUS cannot be written, so the frontend shows no storage notice"
fi

# One ROM folder for each system of the image, as the definition asks for
# the first boot. The names are the file names of data/systems.
for system in "$SYSTEMS"/*.toml; do
	[ -e "$system" ] || continue
	name=${system##*/}
	mkdir -p "$SHARE/roms/${name%.toml}"
done
mkdir -p "$SHARE/bios"
# On exFAT the mount gives every folder to nobody; in a RAM folder the
# folders that root just made need it too.
if [ "$share_kind" = ram ]; then
	chown -R "$SHARE_OWNER:$SHARE_OWNER" "$SHARE"
fi

# The lines of this boot, after those of the last boots, written directly:
# they do not depend on syslogd.
if [ "$state_writable" = yes ]; then
	storage_log=$STATE/log/storage.log
	if mkdir -p "$STATE/log" &&
		{
			cat "$storage_log" 2>/dev/null
			echo "== boot $(date)"
			printf '%s' "$boot_lines"
		} | tail -n "$STORAGE_LOG_LINES" > "$storage_log.new" &&
		mv "$storage_log.new" "$storage_log"; then
		sync
	else
		log "$storage_log cannot be written"
	fi
fi
exit 0
