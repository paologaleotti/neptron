#!/bin/sh
# Starts a DHCP client on each wired interface. The boot to the game list
# must never wait for the network, and a PC with no cable must boot as fast
# as with one: so each client runs as a background job in the foreground
# mode of udhcpc (-f), and this script returns at once. With no lease,
# udhcpc tries again by itself. The kernel names wired ports eth* (no udev
# renames them); en* covers a later rename.

# mdev runs this script through net-hotplug with umask 0. The pid files
# name the processes that root kills later, and udhcpc writes
# /etc/resolv.conf: no file of this script may be writable by others.
umask 022

# NEPTRON_RUN and NEPTRON_SYS_NET change /run/neptron and /sys/class/net
# for a test.
PIDDIR=${NEPTRON_RUN:-/run/neptron}/dhcp
SYS_NET=${NEPTRON_SYS_NET:-/sys/class/net}
# mdev runs this script again for a port that appears after the boot
# (usr/libexec/neptron/net-hotplug), so two starts can overlap. A start
# waits for the lock at most this many pauses of this length, in
# microseconds (5 s in all).
LOCK=$PIDDIR.lock
LOCK_TRIES=50
LOCK_RETRY_US=100000

wired() {
	for path in "$SYS_NET"/eth* "$SYS_NET"/en*; do
		[ -e "$path" ] || continue
		echo "${path##*/}"
	done
}

# 0 when the client of port $1 runs, from its pid file.
client_runs() {
	pid=$(cat "$PIDDIR/$1.pid" 2>/dev/null) || return 1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

lock() {
	tries=0
	until mkdir "$LOCK" 2>/dev/null; do
		tries=$((tries + 1))
		[ "$tries" -lt "$LOCK_TRIES" ] || return 1
		usleep "$LOCK_RETRY_US"
	done
}

start() {
	mkdir -p "$PIDDIR"
	if ! lock; then
		echo "neptron-network: another start holds $LOCK; no DHCP client started"
		return
	fi
	for iface in $(wired); do
		if client_runs "$iface"; then
			echo "neptron-network: $iface already has a DHCP client"
			continue
		fi
		ip link set dev "$iface" up 2>/dev/null
		# -R releases the lease at stop; -x hostname lets a router that
		# keeps a local DNS resolve the name of the PC.
		udhcpc -f -R -S -i "$iface" -x "hostname:$(hostname)" \
			-p "$PIDDIR/$iface.pid" > /dev/null 2>&1 < /dev/null &
		# The client writes the same pid later; the file is there at once,
		# so a start that follows sees this client.
		echo "$!" > "$PIDDIR/$iface.pid"
		echo "neptron-network: DHCP on $iface in the background"
	done
	rmdir "$LOCK"
}

stop() {
	for file in "$PIDDIR"/*.pid; do
		[ -r "$file" ] || continue
		kill "$(cat "$file")" 2>/dev/null
		rm -f "$file"
	done
}

case "$1" in
start) start ;;
stop) stop ;;
restart)
	stop
	start
	;;
*)
	echo "usage: $0 start|stop|restart"
	exit 1
	;;
esac
exit 0
