# BusyBox options on top of the Buildroot default configuration.
# The init script S99neptron-run stops the host command at its deadline.
CONFIG_TIMEOUT=y
# /usr/libexec/neptron/net-address takes its lock with the flock command
# (util-linux or this BusyBox applet; the PC and Pi images install the
# util-linux one). The Buildroot default turns the applet on too; this line
# keeps it on when that default changes.
CONFIG_FLOCK=y
