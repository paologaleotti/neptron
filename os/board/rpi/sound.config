# Sound options of the Raspberry Pi kernel. ALSA and ASoC are built in,
# because vc4 needs them. snd_bcm2835 drives the 3.5 mm jack through the
# firmware (dtparam=audio=on in config.txt); the vc4 overlay sets
# snd_bcm2835.enable_hdmi=0, so HDMI audio comes from vc4. USB audio is
# built in for a USB DAC.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_BCM2835_VCHIQ=y
CONFIG_SND_BCM2835=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
