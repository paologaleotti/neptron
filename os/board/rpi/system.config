# System options of the Raspberry Pi kernel on top of bcm2711_defconfig.
# 4K pages, as the Buildroot Pi boards use them. The Pi 3 has no ACPI and
# no PSCI power-off: the watchdog driver turns a power-off into a halt of
# the firmware (partition 63 of the watchdog), and a reboot into a reset.
# check-kernel-config.sh requires it.
CONFIG_ARM64_4K_PAGES=y
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y
# The CPU clock stays at its top rate. With the ondemand governor the clock
# falls to 600 MHz in a light scene, and the next heavy frame then misses
# its field (seen on a Pi 3 B with an SNES game: 24 to 30 missed fields in
# a burst). The firmware still lowers the clock when the board is too hot.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
