# Console options of the Raspberry Pi kernel. No virtual terminal: keys
# from a keyboard encoder cannot reach a console. The kernel log goes to
# the serial port of GPIO 14 and 15 (console=serial0 in cmdline.txt),
# which only the development variant turns on. CONFIG_VT can be turned
# off only with CONFIG_EXPERT.
CONFIG_EXPERT=y
# CONFIG_VT is not set
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
