# Network options of the Raspberry Pi kernel: the USB Ethernet chips of
# the Pi 3 B (SMSC LAN9514) and the Pi 3 B+ (LAN7515), and the kernel SMB
# server of the network share (docs/spec/network-share.md). They need no
# firmware file.
CONFIG_NETDEVICES=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_SMB_SERVER=y
# The 6.18 server has no SMB1 code; check-kernel-config.sh fails the
# build if the SMB1 option of older kernels is on. No RDMA transport and
# no Kerberos (on by default): the share has guests only.
# CONFIG_SMB_INSECURE_SERVER is not set
# CONFIG_SMB_SERVER_SMBDIRECT is not set
# CONFIG_SMB_SERVER_KERBEROS5 is not set
CONFIG_SMB_SERVER_CHECK_CAP_NET_ADMIN=y
# No IPv6. bcm2711_defconfig makes it a module, which the IPv6 socket of
# ksmbd or mdnsd loads on demand. The guest share is for the local network
# only, and IPv6 autoconfiguration (SLAAC) can give the port a global
# address that the internet reaches. check-kernel-config.sh fails the
# build when it is on.
# CONFIG_IPV6 is not set
# The image has no Wi-Fi and no Bluetooth: no firmware files for them, and
# no daemon. No CAN bus either.
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
# The packet filter of the network share, built in, so that no module
# load can fail at boot: iptables-legacy-restore loads
# /etc/neptron/share-filter.rules into the filter table of IPv4. Since
# Linux 6.17 the legacy tables need NETFILTER_XTABLES_LEGACY. xt_tcpudp,
# the match of the port rules, is part of NETFILTER_XTABLES.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
