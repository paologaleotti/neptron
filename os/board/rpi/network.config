# Network options of the Raspberry Pi kernel: the USB Ethernet chips of
# the Pi 3 B (SMSC LAN9514) and the Pi 3 B+ (LAN7515), and the kernel SMB
# server of the network share (docs/spec/network-share.md). They need no
# firmware file.
CONFIG_NETDEVICES=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_SMB_SERVER=y
# The 6.18 server has no SMB1 code; check-kernel-config.sh fails the
# build if the SMB1 option of older kernels is on. No RDMA transport and
# no Kerberos (on by default): the share has guests only.
# CONFIG_SMB_INSECURE_SERVER is not set
# CONFIG_SMB_SERVER_SMBDIRECT is not set
# CONFIG_SMB_SERVER_KERBEROS5 is not set
CONFIG_SMB_SERVER_CHECK_CAP_NET_ADMIN=y
# The image has no Wi-Fi and no Bluetooth: no firmware files for them, and
# no daemon. No CAN bus either.
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
