# Input options of the Raspberry Pi kernel: USB keyboards, keyboard
# encoders and gamepads through evdev, and uinput for the virtual devices
# of the tests. The same drivers as the PC image, built in.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_SONY=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_PLAYSTATION=y
