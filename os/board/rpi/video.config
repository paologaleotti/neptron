# Video options of the Raspberry Pi kernel. vc4 drives HDMI and the
# composite encoder (VEC) and is the GLES device of the Pi 3; v3d is the
# 3D engine of the Pi 4 and 5. Both are built in. vc4 needs ALSA and
# ASoC built in for its HDMI audio (sound.config).
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
# The DDC bus of HDMI on the Pi 3, which carries the EDID, is a port of
# the BCM2835 I2C controller. Built in, so vc4 reads the EDID of the
# display at boot with no module to load first.
CONFIG_I2C_BCM2835=y
# The kernel must set no mode of its own: no fbdev emulation, no
# framebuffer console, no firmware framebuffer (bcm2708_fb and simplefb
# need CONFIG_FB), no DRM log client and no panic screen.
# CONFIG_FB is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM_SIMPLEDRM is not set
# CONFIG_SYSFB_SIMPLEFB is not set
# CONFIG_DRM_PANIC is not set
# CONFIG_DRM_CLIENT_LOG is not set
# CONFIG_LOGO is not set
# No camera, no TV tuner and no video codec drivers. The HDMI CEC core,
# which vc4 selects, is outside this menu.
# CONFIG_MEDIA_SUPPORT is not set
