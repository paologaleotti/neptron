# BusyBox options of the PC image on top of the common fragment. No network
# service of BusyBox runs: no telnet server, no web server, and no cron,
# which would be periodic background work while a game runs.
# CONFIG_TELNETD is not set
# CONFIG_HTTPD is not set
# CONFIG_CROND is not set
CONFIG_MOUNTPOINT=y
CONFIG_READLINK=y
CONFIG_FEATURE_READLINK_FOLLOW=y
