#!/bin/sh
# Development variant: prints the address of eth0 on the serial console and
# writes it to /share/neptron-ip.txt, so the bench can find the PC from
# another computer. DHCP can take a while, so this runs in the background.

[ "$1" = start ] || exit 0

(
	address=
	tries=0
	while [ -z "$address" ] && [ "$tries" -lt 60 ]; do
		address=$(ip -4 addr show dev eth0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)
		[ -n "$address" ] || sleep 1
		tries=$((tries + 1))
	done
	echo "neptron: eth0 address ${address:-none}" > /dev/console
	echo "${address:-none}" > /share/neptron-ip.txt && sync
) &
