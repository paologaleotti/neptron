# Video options of the PC image. The kernel must set no mode of its own:
# no fbdev emulation, no framebuffer console, no firmware framebuffer
# device and no panic screen. i915 is built in for the i3-6100T (HD 530).
# amdgpu, radeon and vkms are modules: amdgpu and radeon load by their
# device ids, and vkms loads only in a QEMU test run.
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_VKMS=m
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_FB is not set
# CONFIG_DRM_SIMPLEDRM is not set
# CONFIG_SYSFB_SIMPLEFB is not set
# CONFIG_DRM_PANIC is not set
# CONFIG_DRM_BOCHS is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_QXL is not set
# CONFIG_DRM_CIRRUS_QEMU is not set
# CONFIG_LOGO is not set

# vkms reports its frame CRCs through debugfs.
CONFIG_DEBUG_FS=y
