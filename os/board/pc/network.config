# Network options of the PC image: the Intel and Realtek Ethernet
# controllers of common desktop boards, and the kernel SMB server of the
# network share (docs/spec/network-share.md).
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_SMB_SERVER=y
# The 6.18 server has no SMB1 code; check-kernel-config.sh fails the
# build if the SMB1 option of older kernels is on. No RDMA transport and
# no Kerberos (on by default): the share has guests only.
# CONFIG_SMB_INSECURE_SERVER is not set
# CONFIG_SMB_SERVER_SMBDIRECT is not set
# CONFIG_SMB_SERVER_KERBEROS5 is not set
CONFIG_SMB_SERVER_CHECK_CAP_NET_ADMIN=y
