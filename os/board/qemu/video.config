# Video options of the QEMU images: vkms is the display. The kernel itself
# must set no mode, so there is no fbdev emulation and no framebuffer console.
CONFIG_DRM=y
CONFIG_DRM_VKMS=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# vkms reports its frame CRCs through debugfs.
CONFIG_DEBUG_FS=y
