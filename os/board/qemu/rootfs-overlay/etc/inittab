# BusyBox init table of the aarch64 QEMU test image.
# Format: <id>::<action>:<process>. BusyBox init has no runlevels.

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# A root shell on the console, with no login, for the emulated target.
console::respawn:/sbin/getty -n -l /bin/sh -L console 0 vt100

# The boot check of `cargo xtask os boot-check`: the launcher starts as on a
# PC, and the check runs beside it. Without a boot check neither starts, so
# the tools of the other checks get the display.
::once:/usr/libexec/neptron/launch-for-check
::once:/usr/libexec/neptron/host-run check

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
