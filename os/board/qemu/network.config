# The kernel SMB server of the network share, as in the PC image
# (board/pc/network.config), so that the boot check sees it listen.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_SMB_SERVER=y
# CONFIG_SMB_INSECURE_SERVER is not set
# CONFIG_SMB_SERVER_SMBDIRECT is not set
# CONFIG_SMB_SERVER_KERBEROS5 is not set
CONFIG_SMB_SERVER_CHECK_CAP_NET_ADMIN=y
# No IPv6, as in the PC and Raspberry Pi images.
# CONFIG_IPV6 is not set
# The packet filter of the network share, built in, so that no module
# load can fail at boot: iptables-legacy-restore loads
# /etc/neptron/share-filter.rules into the filter table of IPv4. Since
# Linux 6.17 the legacy tables need NETFILTER_XTABLES_LEGACY. xt_tcpudp,
# the match of the port rules, is part of NETFILTER_XTABLES.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
