((((((((((((((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((((((((((((((((((((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((ииииииииииии((((((((((((((((((((((((((((ииииииииииииииииииииииии((((((((((((((((ииииииииииииииииииииииии((((((((((((((((ииииииииииииииииииииииии((((((((((((((((ииииииииииииииииииииииии((((((((((((ииииииииииииииииииииииииииииииииииии((((((((ииииииииииии((((((((((((ииииииииииии((((((((((((ииииииииииии((((((((((((((((((((((((((((((((((((((((ииииииииииииииииииииииииииииииииииии((((((((((((((((ииииииииииииииииииииииии((((((((((((((((((((((((((((((((ииииииииииии((((((((((((ииииииииииии((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((ииииииииииииииииииииииииииииииииииииииииииииииии((((((((((((((((((((((((((((((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((((((((((((((((((((((((((((((ииииииииииии((((((((((((((((((((ииииииииииииииииииииииииииииииииииии((((((((((((((((ииииииииииииииииииииииии((((((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((ииииииииииии((((((((((((((((((((((((((((((((((((((((((((((((ииииииииииии((((((((((((((((((((ииииииииииииииииииииииииииииииииииии((((((((ииииииииииии((((((((((((((((((((((((((((((((((((((((((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((((((ииииииииииииииииииииииииииииииииииииииииииииииии((((ииииииииииии((((((((((((ииииииииииии((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((ииииииииииии((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((ииииииииииии((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((ииииииииииии((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((