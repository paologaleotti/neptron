config BR2_PACKAGE_LIBRETRO_FBNEO
	bool "libretro-fbneo"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  FinalBurn Neo, the libretro core for arcade boards: Neo Geo,
	  CPS-1, CPS-2, Cave and many others.
	  Licence: the FB Neo licence, for non-commercial use only, with
	  the MAME licence.

	  https://github.com/libretro/FBNeo

comment "libretro-fbneo needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
