# The 15 kHz patch set of D0023R, pinned; see os/patches/linux/linux.hash.
# LICENCE QUESTION: the LICENSE file of the patch repository says GPL-3.0,
# and the kernel is GPL-2.0 only. The owner has asked the author to clarify.
# No image built with these patches may be distributed until that is
# resolved. `cargo xtask os build --no-kernel-15khz` builds without them.
BR2_LINUX_KERNEL_PATCH="https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/01_linux_15khz.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/02_linux_15khz_interlaced_mode_fix.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/03_linux_15khz_dcn1_dcn2_dcn3_interlaced_mode_fix.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/04_linux_15khz_dce_interlaced_mode_fix.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/05_linux_15khz_amdgpu_pll_fix.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/06_linux_switchres_kms_drm_modesetting.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/07_linux_15khz_fix_ddc.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/08_linux_15khz_interlace_force_even.patch https://raw.githubusercontent.com/D0023R/linux_kernel_15khz/8c96dd9f0b343a6d1ef3c61041783ee106957886/linux-6.18/09_linux_15khz_i915_gen9_interlace.patch"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/video.config $(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/console.config $(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/input.config $(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/sound.config $(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/storage.config $(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/network.config $(BR2_EXTERNAL_NEPTRON_PATH)/board/qemu/host.config"
