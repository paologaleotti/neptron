# The development variant of the PC image, for the hardware tests. It is
# merged on top of neptron_pc_x86_64_defconfig by
# `cargo xtask os build --arch x86_64 --dev-key FILE`, in its own output.
# The release image has none of this.
#
# An SSH server that accepts only the public key given at build time, and
# no password; a DHCP client on the first Ethernet port; the control
# commands of the frontend that change it (Cargo feature control); and the
# overlay board/pc/dev-overlay: the hot folder for `cargo xtask os push`,
# the log file on the state partition, and the address of eth0. Also the
# firmware of the Realtek Ethernet chips, below.
BR2_PACKAGE_DROPBEAR=y
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_NEPTRON_CONTROL=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NEPTRON_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/rootfs-overlay $(BR2_EXTERNAL_NEPTRON_PATH)/board/pc/dev-overlay"
# The firmware of the Realtek RTL8168 family (rtl_nic/*.fw), which r8169
# asks for when eth0 opens. The licence is the Realtek notice in the file
# WHENCE of linux-firmware: distribution is allowed with the copyright
# notice. Buildroot puts WHENCE in the licence files of the package, so
# legal-info and the manifest of the image list it.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
