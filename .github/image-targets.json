{
  "targets": [
    {
      "name": "x86_64",
      "enabled": true,
      "description": "The PC image, with the 15 kHz kernel patch set (GPL-2.0-only, ADR 0018). The timing checks run here, under KVM",
      "runner": "ubuntu-24.04",
      "arch": "x86_64",
      "defconfig": "neptron_pc_x86_64_defconfig",
      "fragments": [],
      "base_paths": ["os/patches", "os/package/libretro-*", "os/board/common/*.config", "os/board/pc/*.config", "os/board/qemu/*.config"],
      "build_args": ["--arch", "x86_64", "--output", "x86_64"],
      "images_dir": "x86_64",
      "image_files": ["neptron-x86_64.img"],
      "licences": "os/board/pc/LICENCES.txt",
      "artifact": "neptron-pc-x86_64",
      "upload_image": true,
      "rebuild": ["neptron", "neptron-launch", "neptronctl", "neptron-capture", "neptron-vkms-probe"],
      "checks": ["boot-bios", "boot-uefi", "app", "kms", "gles", "selftest", "core", "share"],
      "build_minutes": 320
    },
    {
      "name": "aarch64",
      "enabled": true,
      "description": "The aarch64 QEMU test image. The arm runner has no KVM, so the timing checks (kms, selftest, core) run on a developer machine with a hypervisor",
      "runner": "ubuntu-24.04-arm",
      "arch": "aarch64",
      "defconfig": "neptron_qemu_aarch64_defconfig",
      "fragments": [],
      "base_paths": ["os/patches", "os/package/libretro-*", "os/board/common/*.config", "os/board/qemu/*.config"],
      "build_args": ["--arch", "aarch64"],
      "images_dir": "aarch64",
      "image_files": ["Image", "rootfs.ext4"],
      "licences": "",
      "artifact": "neptron-qemu-aarch64",
      "upload_image": false,
      "rebuild": ["neptron", "neptron-launch", "neptronctl", "neptron-capture", "neptron-vkms-probe"],
      "checks": ["boot", "app", "gles"],
      "build_minutes": 240
    },
    {
      "name": "rpi-arm64",
      "enabled": true,
      "description": "The Raspberry Pi image, release variant. QEMU does not boot it; the build checks its kernel configuration and that its kernel takes no patch",
      "runner": "ubuntu-24.04-arm",
      "arch": "rpi-arm64",
      "defconfig": "neptron_rpi_arm64_defconfig",
      "fragments": [],
      "base_paths": ["os/board/rpi/patches", "os/package/libretro-*", "os/board/common/*.config", "os/board/pc/busybox.config", "os/board/rpi/*.config"],
      "build_args": ["--arch", "rpi-arm64"],
      "images_dir": "rpi-arm64",
      "image_files": ["neptron-rpi-arm64.img"],
      "licences": "os/board/rpi/LICENCES.txt",
      "artifact": "neptron-rpi-arm64",
      "upload_image": true,
      "rebuild": ["neptron", "neptron-launch", "neptronctl"],
      "checks": ["pi-layout"],
      "build_minutes": 300
    }
  ]
}
